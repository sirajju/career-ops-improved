{
  "manifest_version": 3,
  "name": "Career Ops Job Clipper",
  "version": "1.0.0",
  "description": "Clip job listings from LinkedIn, Naukri, Indeed, Glassdoor, Wellfound, Instahyre, and direct ATS boards straight into your local Career Ops pipeline.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "clipboardWrite"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.linkedin.com/*",
        "*://*.naukri.com/*",
        "*://*.indeed.com/*",
        "*://*.indeed.co.in/*",
        "*://*.glassdoor.com/*",
        "*://*.glassdoor.co.in/*",
        "*://*.wellfound.com/*",
        "*://wellfound.com/*",
        "*://*.instahyre.com/*",
        "*://*.greenhouse.io/*",
        "*://*.lever.co/*",
        "*://*.ashbyhq.com/*",
        "*://*.myworkdayjobs.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Career Ops Clipper",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
